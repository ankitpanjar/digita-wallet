# --- App ---
PORT=3000

# --- Docker MySQL (used by docker-compose.yml only) ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=digital_wallet

# --- Database (special characters in the password must be URL-encoded, e.g. @ -> %40) ---
DATABASE_URL="mysql://root:change-me@localhost:3306/digital_wallet"

# Max simultaneous DB connections (default 10)
DB_POOL_SIZE=10

# --- Logging --- (fatal | error | warn | log | debug | verbose)
LOG_LEVEL=log

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Rate limiting (per user, or per IP for anonymous calls) ---
THROTTLE_PER_MINUTE=60
THROTTLE_PER_HOUR=1000
# Tighter limit on register/login (per IP)
AUTH_THROTTLE_PER_MINUTE=10
AUTH_THROTTLE_PER_HOUR=60

# --- Fraud / limits (all amounts in USD) ---
DAILY_LIMIT_USD=10000
HIGH_VALUE_THRESHOLD_USD=2000
HIGH_VALUE_MAX_COUNT=3
HIGH_VALUE_WINDOW_MINUTES=10

# --- Exchange rates ---
# Leave empty to only use the seeded rates. If set, rates are refreshed from this
# URL every 6 hours. It must return the open.er-api.com format: { "rates": { "EUR": 0.92, ... } }
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
